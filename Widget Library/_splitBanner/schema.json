{
    "name": "Split Banner",
    "schema": [
        {
            "type": "tab",
            "label": "Settings",
            "sections": [
                {
                    "settings": [
                        {
                            "type": "color",
                            "label": "Content Background?",
                            "id": "content_bg_color",
                            "default": ""
                        },
                        {
                            "type": "color",
                            "label": "Text Color",
                            "id": "text_color",
                            "default": ""
                        },
                        {
                            "type": "color",
                            "label": "Slide Overlay Color?",
                            "id": "slide_overlay",
                            "default": ""
                        },
                        {
                            "type": "range",
                            "label": "Content Padding",
                            "id": "content_padding",
                            "default": 0,
                            "typeMeta": {
                                "rangeValues": {
                                    "min": 0,
                                    "max": 100,
                                    "step": 1,
                                    "unit": "%"
                                }
                            }
                        },
                        {
                            "type": "select",
                            "label": "Reverse Columns?",
                            "id": "reverse",
                            "default": "false",
                            "typeMeta": {
                                "selectOptions": [
                                    {
                                        "label": "true",
                                        "value": "true"
                                    },
                                    {
                                        "label": "false",
                                        "value": "false"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "input",
                            "label": "Eyebrow",
                            "id": "eyebrow",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "label": "Heading Tag",
                            "id": "heading_tag",
                            "default": "h2",
                            "typeMeta": {
                                "selectOptions": [
                                    {
                                        "label": "h1",
                                        "value": "h1"
                                    },
                                    {
                                        "label": "h2",
                                        "value": "h2"
                                    },
                                    {
                                        "label": "h3",
                                        "value": "h3"
                                    },
                                    {
                                        "label": "h4",
                                        "value": "h4"
                                    },
                                    {
                                        "label": "h5",
                                        "value": "h5"
                                    },
                                    {
                                        "label": "h6",
                                        "value": "h6"
                                    },
                                    {
                                        "label": "p",
                                        "value": "p"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "input",
                            "label": "Heading",
                            "id": "heading_text",
                            "default": ""
                        },
                        {
                            "type": "input",
                            "label": "Text",
                            "id": "text",
                            "default": ""
                        },
                        {
                            "type": "visibility",
                            "label": "Button 1 Visibility",
                            "id": "show_button_1",
                            "default": "show"
                        },
                        {
                            "type": "input",
                            "id": "button_1_text",
                            "label": "Button 1 Text",
                            "default": "",
                            "conditional": {
                                "key": "show_button_1",
                                "operator": "IN",
                                "value": [
                                    "show"
                                ]
                            }
                        },
                        {
                            "type": "input",
                            "id": "button_1_link",
                            "label": "Button 1 Link",
                            "default": "",
                            "conditional": {
                                "key": "show_button_1",
                                "operator": "IN",
                                "value": [
                                    "show"
                                ]
                            }
                        },
                        {
                            "type": "visibility",
                            "label": "Button 2 Visibility",
                            "id": "show_button_2",
                            "default": "show"
                        },
                        {
                            "type": "input",
                            "id": "button_2_text",
                            "label": "Button 2 Text",
                            "default": "",
                            "conditional": {
                                "key": "show_button_2",
                                "operator": "IN",
                                "value": [
                                    "show"
                                ]
                            }
                        },
                        {
                            "type": "input",
                            "id": "button_2_link",
                            "label": "Button 2 Link",
                            "default": "",
                            "conditional": {
                                "key": "show_button_2",
                                "operator": "IN",
                                "value": [
                                    "show"
                                ]
                            }
                        },
                        {
                            "type": "imageManager",
                            "label": "Desktop Image",
                            "id": "image_desktop",
                            "default": {
                                "src": "https://images.unsplash.com/photo-1487700160041-babef9c3cb55?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=2000&q=80",
                                "type": "IMAGE_MANAGER"
                            }
                        },
                        {
                            "type": "input",
                            "label": "Destkop image ALT",
                            "id": "image_desktop_alt",
                            "default": ""
                        },
                        {
                            "type": "imageManager",
                            "label": "Mobile Image",
                            "id": "image_mobile",
                            "default": {
                                "src": "https://images.unsplash.com/photo-1487700160041-babef9c3cb55?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=2000&q=80",
                                "type": "IMAGE_MANAGER"
                            }
                        },
                        {
                            "type": "input",
                            "label": "Mobile image ALT",
                            "id": "image_mobile_alt",
                            "default": ""
                        },
                        {
                            "type": "select",
                            "label": "Mobile Image Width",
                            "id": "mobile_img_width",
                            "default": "auto",
                            "typeMeta": {
                                "selectOptions": [
                                    {
                                        "label": "Full Width",
                                        "value": "100%"
                                    },
                                    {
                                        "label": "Auto Width",
                                        "value": "auto"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "template": "<style> [id='{{_.id}}'] { {{#if content_bg_color}} background-color: {{content_bg_color}}; {{/if}} } [id='{{_.id}}'] .splitBanner-content .text, [id='{{_.id}}'] .splitBanner-content .heading, [id='{{_.id}}'] .splitBanner-content .eyebrow { {{#if text_color}} color: {{text_color}}; {{/if}} } [id='{{_.id}}'] .splitBanner-column.content { {{#gt max_width 0}} @media (min-width: 1400px) { padding-left: initial; padding-right: {{content_padding}}%; } {{/gt}} } [id='{{_.id}}'] .splitBanner-container.reverse .splitBanner-column.content { {{#gt max_width 0}} padding-left: initial; padding-right: initial; @media (min-width: 1400px) { padding-right: initial; padding-left: {{content_padding}}%; } {{/gt}} } {{#if slide_overlay}} [id='{{_.id}}'] .splitBanner-image::after { content: ''; position: absolute; top: 50%; left: 50%; height: 100%; width: 100%; transform: translate(-50%, -50%); background-color: {{slide_overlay}}; } {{/if}} [id='{{_.id}}'] .splitBanner-image img.mobile { width: {{mobile_img_width}}; } </style> <div class='splitBanner' id='{{_.id}}'> <div class='splitBanner-container {{#if reverse \"===\" \"true\"}} reverse{{/if}}'> <div class='splitBanner-column content'> <div class='splitBanner-content'> {{#if eyebrow}} <span class='eyebrow'>{{eyebrow}}</span> {{/if}} {{#if heading_text}} <{{heading_tag}} class='heading'>{{{heading_text}}}</{{heading_tag}}> {{/if}} {{#if text}} <p class='text'> {{{text}}} </p> {{/if}} <div class='splitBanner-actions'> {{#if show_button_1 '===' 'show'}} <a href='{{{button_1_link}}}' class='button'>{{{button_1_text}}}</a> {{/if}} {{#if show_button_2 '===' 'show'}} <a href='{{{button_2_link}}}' class='button'>{{{button_2_text}}}</a> {{/if}} </div> </div> </div> <div class='splitBanner-column media'> <div class='splitBanner-image'> <img src='{{image_mobile.src}}' alt='{{mobile_alt}}' class='mobile'> <img src='{{image_desktop.src}}' alt='{{desktop_alt}}' class='desktop'> </div> </div> </div> </div>"            
}